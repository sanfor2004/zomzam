{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-electron",
    "rootDir": "electron",
    "noEmit": false,
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "electron"],
    "jsx": "react-jsx",
    "incremental": false,
    "plugins": []
  },
  "include": ["electron/**/*.ts"],
  "exclude": ["node_modules"]
}

