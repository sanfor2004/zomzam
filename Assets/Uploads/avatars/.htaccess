# Security: Prevent script execution in uploads directory
# This prevents uploaded files from being executed as PHP or other server-side scripts

# Deny access to PHP files
<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|phps|phar|inc|cgi|pl|py|jsp|asp|aspx|shtml|sh|exe)$">
  Order Deny,Allow
  Deny from all
</FilesMatch>

# Remove PHP handler
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phps .phar

# Disable directory browsing
Options -Indexes

# Disable script execution
Options -ExecCGI

# Force download for certain file types (additional security layer)
<FilesMatch "\.(?i:html|htm|js|xml|json)$">
  ForceType application/octet-stream
  Header set Content-Disposition attachment
</FilesMatch>

# Only allow image files to be served
<FilesMatch "\.(?i:jpg|jpeg|png|gif|webp)$">
  Order Allow,Deny
  Allow from all
  # Serve with correct MIME types
  ForceType image/jpeg
</FilesMatch>

# Prevent access to hidden files
<FilesMatch "^\.">
  Order Deny,Allow
  Deny from all
</FilesMatch>

# Additional security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
