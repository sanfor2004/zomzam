# ──────────────────────────────────────────────────────────
#  Zomzam — Environment Variables (EXAMPLE)
#  Copy this file to `.env` and fill in real values:
#      cp .env.example .env
#  NEVER commit your real `.env` — it is gitignored.
# ──────────────────────────────────────────────────────────

# ── Database (MySQL / MariaDB) ──────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zomzam_db
DB_USER=root
DB_PASS=AM01277843543
DB_CHARSET=utf8mb4

# ── Authentication ──────────────────────────────────────────
# Secret used to sign session JWTs. Generate a strong random
# value (do NOT reuse this placeholder in production):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Environment ─────────────────────────────────────────────
# development | production | test
NODE_ENV=development

# ── Optional integrations ───────────────────────────────────
# Google Maps API key used by the CRM "shops" lookup. Can also
# be set per-user in CRM settings; leave blank to disable.
GOOGLE_MAPS_API_KEY=
