# ──────────────────────────────────────────────────────────
#  Zomzam — Environment Variables (EXAMPLE)
#  Copy this file to `.env` and fill in real values:
#      cp .env.example .env
#  NEVER commit your real `.env` — it is gitignored.
# ──────────────────────────────────────────────────────────

# ── Database (MySQL / MariaDB) ──────────────────────────────
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=

# ── Authentication ──────────────────────────────────────────
# Secret used to sign session JWTs. Generate a strong random
# value (do NOT reuse this placeholder in production):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Environment ─────────────────────────────────────────────
# development | production | test
NODE_ENV=

# ── File uploads (Vercel Blob) ───────────────────────────────
# Avatar + post-image uploads (lib/uploads.ts) are stored in Vercel Blob —
# Vercel's serverless functions have a read-only filesystem, so local-disk
# storage doesn't survive a deploy. Attach a Blob store to the project at
#   https://vercel.com/dashboard -> Storage -> Create Database -> Blob
# which auto-injects this var in production. For local dev, pull it down with
# `vercel env pull .env` or copy the token from the dashboard's ".env.local" tab.
BLOB_READ_WRITE_TOKEN=

# ── Transactional email (SMTP — e.g. Hostinger) ──────────────
# Password-reset email sends via SMTP (lib/email.ts, nodemailer). Create a
# mailbox in Hostinger hPanel → Emails and use its credentials below. Without
# these the app runs fine but the send no-ops (a warning is logged, and in
# development forgot-password returns a demo_token so the flow stays testable).
#   SMTP_HOST  → smtp.hostinger.com
#   SMTP_PORT  → 465 (SSL) or 587 (STARTTLS)
#   SMTP_USER  → the full mailbox address (also the default From)
#   SMTP_PASS  → that mailbox's password
#   EMAIL_FROM → optional display sender; defaults to SMTP_USER
#   APP_URL    → public origin used to build links in emails (e.g. the reset
#                link). Falls back to the request origin when unset.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
APP_URL=

# ── Optional integrations ───────────────────────────────────
# Google Maps API key used by the CRM "shops" lookup. Can also
# be set per-user in CRM settings; leave blank to disable.
GOOGLE_MAPS_API_KEY=

# ── Google Sign-In (OAuth 2.0) ───────────────────────────────
# Create a Web application OAuth client at
#   https://console.cloud.google.com/apis/credentials
# The redirect URI below must be added to the client's "Authorized
# redirect URIs" exactly as written (swap the host in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
