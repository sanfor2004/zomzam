# ──────────────────────────────────────────────────────────
#  Zomzam — Environment Variables (EXAMPLE)
#  Copy this file to `.env` and fill in real values:
#      cp .env.example .env
#  NEVER commit your real `.env` — it is gitignored.
# ──────────────────────────────────────────────────────────

# ── Database (MySQL / MariaDB) ──────────────────────────────
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=

# ── Authentication ──────────────────────────────────────────
# Secret used to sign session JWTs. Generate a strong random
# value (do NOT reuse this placeholder in production):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Environment ─────────────────────────────────────────────
# development | production | test
NODE_ENV=

# ── Optional integrations ───────────────────────────────────
# Google Maps API key used by the CRM "shops" lookup. Can also
# be set per-user in CRM settings; leave blank to disable.
GOOGLE_MAPS_API_KEY=

# ── Google Sign-In (OAuth 2.0) ───────────────────────────────
# Create a Web application OAuth client at
#   https://console.cloud.google.com/apis/credentials
# The redirect URI below must be added to the client's "Authorized
# redirect URIs" exactly as written (swap the host in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback

# ── Facebook Sign-In / Sign-Up (OAuth 2.0) ───────────────────
# Create a Facebook Login product at
#   https://developers.facebook.com/apps/
# The redirect URI below must be added to "Valid OAuth Redirect URIs"
# exactly as written (swap the host in production).
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/facebook/callback
