# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# runtime logs
/Logs/

# user-uploaded avatars (runtime sharp pipeline output + db:seed dev artifacts).
# The directory itself is kept via .gitkeep so the upload pipeline always has a
# target; only its contents are ignored so dev-seed PNGs never ship to prod.
/public/Assets/Uploads/avatars/*
!/public/Assets/Uploads/avatars/.gitkeep

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify knowledge-graph output (generated locally, not source)
graphify-out/
