# ============================================================================
# zomzam.com - Clean URL Routing Configuration
# ============================================================================

RewriteEngine On
RewriteBase /

# Block DIRECT browser access to sensitive directories (not internal rewrites)
RewriteCond %{THE_REQUEST} \s/+(Models|Config|Api_handler|migrations|database|scripts|storage|logs|Views)/ [NC]
RewriteRule ^ - [F,L]

# Block access to sensitive files
RewriteRule ^(README\.md|config\.php|setup_db\.php|composer\.(json|lock)|package\.json)$ - [F,NC,L]

# Prevent access to backup and config files
<FilesMatch "\.(bak|backup|old|tmp|temp|log|env|conf|config|ini|git|gitignore)$">
    Require all denied
</FilesMatch>

# CORS Headers for API
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header always set Access-Control-Allow-Credentials "true"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Allow direct access to Assets folder
RewriteCond %{REQUEST_URI} ^/Assets/
RewriteRule ^ - [L]

# ============================================================================
# API Routes - /api/{service}
# ============================================================================

# API Authentication endpoints
RewriteRule ^api/auth/?$ Api_handler/auth.php [L,QSA]
RewriteRule ^api/auth/forgot-password/?$ Api_handler/profile.php [L,QSA]
RewriteRule ^api/auth/reset-password/?$ Api_handler/profile.php [L,QSA]

# API Profile endpoints
RewriteRule ^api/profile/update/?$ Api_handler/profile.php [L,QSA]
RewriteRule ^api/profile/change-password/?$ Api_handler/profile.php [L,QSA]

# API User endpoints
RewriteRule ^api/user/?$ Api_handler/user.php [L,QSA]

# API Logout
RewriteRule ^api/logout/?$ Api_handler/logout.php [L,QSA]

# Generic API handler (fallback for other API files)
RewriteRule ^api/([a-zA-Z0-9_-]+)/?$ Api_handler/$1.php [L,QSA]

# ============================================================================
# Clean URL Routes (No .php extensions)
# ============================================================================

# Homepage - Landing page (public)
RewriteRule ^$ Views/Landing/main.php [L]

# Authentication route (split signin/signup view)
RewriteRule ^sign/?$ Views/Auth/main.php [L]
RewriteRule ^forgot-password/?$ Views/Auth/forgot-password.php [L]

# Dashboard route - Authenticated users
RewriteRule ^dashboard/?$ Views/Dashboard/home.php [L]

# Time Management Module
RewriteRule ^time/?$ /time/execution [R=302,L]
RewriteRule ^time/execution/?$ Views/Time/execution.php [L]
RewriteRule ^time/tasks/?$     Views/Time/tasks.php [L]
RewriteRule ^time/planning/?$  Views/Time/planning.php [L]
RewriteRule ^time/tracker/?$   Views/Time/tracker.php [L]
RewriteRule ^time/ideas/?$     Views/Time/ideas.php [L]
RewriteRule ^time/api/?$       Views/Time/api.php [L]
# Money Management Module
RewriteRule ^money/?$ /money/dashboard [R=302,L]
RewriteRule ^money/dashboard/?$ Views/Money/dashboard.php [L]
RewriteRule ^money/income/?$    Views/Money/income.php [L]
RewriteRule ^money/expenses/?$  Views/Money/expenses.php [L]
RewriteRule ^money/lend/?$      Views/Money/lend.php [L]
RewriteRule ^money/accounts/?$  Views/Money/accounts.php [L]
RewriteRule ^money/api/?$       Views/Money/api.php [L]

# Profile routes - Authenticated users
RewriteRule ^profile/?$ Views/Dashboard/profile.php [L]
RewriteRule ^change-password/?$ Views/Dashboard/change-password.php [L]

# Logout route (redirect to API)
RewriteRule ^logout/?$ Api_handler/logout.php [L]

# Error pages
RewriteRule ^403/?$ Views/Errors/403.php [L]
RewriteRule ^404/?$ Views/Errors/404.php [L]
RewriteRule ^500/?$ Views/Errors/500.php [L]

# ============================================================================
# General Clean URL Handler
# ============================================================================

# If file exists, serve it directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# If directory exists, serve it directly
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Try to append .php to the request
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# 404 - All unmatched routes
RewriteRule ^ Views/Errors/404.php [L]

